<?xml version="1.0" encoding="UTF-8"?>
<!--
  One entry, because the hub is one page: the About, Skills and Projects
  sections are anchors on it, not routes, and a sitemap lists documents.

  The three apps are deliberately absent. A sitemap may only list URLs on the
  host that serves it, and each app now sits on its own subdomain with its own
  sitemap. All four are submitted under the single DNS-verified evanczako.com
  domain property in Search Console, which is what ties them together — not
  cross-listing them here, which Google would ignore.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>https://evanczako.com/</loc>
        <changefreq>monthly</changefreq>
        <priority>1.0</priority>
    </url>
</urlset>
